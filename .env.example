# Pull real values with: vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ random characters (signs sign-in tokens)
AUTH_SECRET=
# Private Blob store (GCash screenshots, QR image, backups)
BLOB_READ_WRITE_TOKEN=
# Protects the weekly backup route
CRON_SECRET=
# Local only: token of the PUBLIC Blob store that holds the APK (npm run apk:publish)
DOWNLOADS_BLOB_TOKEN=
