{
  "name": "habhab-lpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Habhab LPG Trading - gasul ordering, delivery tracking, utang and POS (Android app + Vercel API)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint api db tools tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "user:create": "tsx db/create-user.ts",
    "dev:local": "tsx tools/dev-server.ts",
    "icons": "tsx tools/make-icons.ts",
    "apk:publish": "tsx tools/apk-publish.ts",
    "qa:smoke": "bash tools/qa/smoke.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
