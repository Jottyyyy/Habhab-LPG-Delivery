{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "db/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "app", ".vercel"]
}
